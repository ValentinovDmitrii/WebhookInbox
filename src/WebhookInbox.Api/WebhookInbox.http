@WebhookInbox_HostAddress = http://localhost:5282

GET {{WebhookInbox_HostAddress}}/health/
Accept: application/json

###
POST {{WebhookInbox_HostAddress}}/api/events
Content-Type: application/json

{
  "source": "github",
  "eventType": "push",
  "payload": "{\"ref\":\"refs/heads/main\"}"
}

###
GET {{WebhookInbox_HostAddress}}/api/events
Accept: application/json

###
GET {{WebhookInbox_HostAddress}}/api/events/{id}]
Accept: application/json

###
DELETE {{WebhookInbox_HostAddress}}/api/events/{id}
